# Provider keys (read directly by the LiveKit plugins and SDKs)
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
PINECONE_API_KEY=

# LiveKit server (`livekit-server --dev` uses devkey/secret); needed for `dev` and the API
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=baatein

# App settings (BAATEIN_<SECTION>__<FIELD>)
BAATEIN_LLM__MODEL=claude-haiku-5-5
BAATEIN_VOICE__DEFAULT_LANGUAGE=hinglish
BAATEIN_DATABASE__URL=sqlite:///data/baatein.db
# Memory embeddings (docs/RETRIEVAL_BENCHMARK.md); run `baatein reembed` after changing.
# For a local model instead: fastembed, intfloat/multilingual-e5-large, 1024.
BAATEIN_EMBEDDING__PROVIDER=pinecone
BAATEIN_EMBEDDING__MODEL=llama-text-embed-v2
BAATEIN_EMBEDDING__DIMENSIONS=2048
BAATEIN_AUTH__JWT_SECRET=change-me-to-a-long-random-string
# Summary written after each call by `baatein serve` (0 turns the background loop off)
BAATEIN_FINALIZE__MODEL=claude-haiku-5-5
BAATEIN_FINALIZE__INTERVAL_SECONDS=10

# Development only: POST /dev/seed and Settings → "Test memories" in the web client (docs/SEED_DATA.md)
BAATEIN_DEV__SEED_ENABLED=false

# Demos only: memory/reminder "now" comes from this file, set with `baatein demo-date` (no file = real time)
# BAATEIN_DEV__CLOCK_FILE=data/demo-clock.json

# Optional: another voice for a language (e.g. an expressive Sarvam voice for a demo). Unset keeps
# each language profile's own voice.
# BAATEIN_VOICE__TTS={"hinglish": {"provider": "sarvam", "pace_option": "pace", "options": {"model": "bulbul:v4-flash", "speaker": "shalini_enhi_companion", "target_language_code": "hi-IN"}}}
