# Provider keys (read directly by the LiveKit plugins)
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=

# Only needed for `dev`/`start` against a LiveKit server (not for `console`)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# App settings (BAATEIN_<SECTION>__<FIELD>)
BAATEIN_LLM__MODEL=claude-haiku-5-5
BAATEIN_VOICE__DEFAULT_LANGUAGE=hinglish
BAATEIN_DATABASE__URL=sqlite:///data/baatein.db
BAATEIN_EMBEDDING__PROVIDER=fastembed
BAATEIN_EMBEDDING__MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BAATEIN_EMBEDDING__DIMENSIONS=384
BAATEIN_MEMORY__MIN_SIMILARITY=0.3
